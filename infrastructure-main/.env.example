# Kong Gateway OSS. Se fija una versión publicada; no se usa `latest`.
KONG_IMAGE=kong:3.9.4

# Puertos publicados por Kong. El 8000 es la entrada pública del frontend.
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

KONG_LOG_LEVEL=info

# Límite de Nginx en Kong. El OCR aplica el límite de negocio de 50 MB.
KONG_CLIENT_MAX_BODY_SIZE=55m

# Origen permitido por CORS. Se renderiza en kong/kong.yml.
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL del OCR. El valor de la contraseña no se versiona.
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_USER=ocr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ocr

# Imágenes locales construidas desde ../ocr.
OCR_API_IMAGE=paperless-ocr-api:local
OCR_WORKER_IMAGE=paperless-ocr-worker:local

# ACL: imagen local y puerto opcional del host (solo diagnóstico).
ACL_API_IMAGE=paperless-acl-api:local
ACL_PORT=5058

# Token compartido entre OCR y ACL para las rutas internas.
# No se versiona el valor real.
INTERNAL_TOKEN=change-me-internal-token

# Paperless: URL interna y token de API. El token se crea en Paperless y no se
# versiona.
PAPERLESS_BASE_URL=http://paperless-webserver:8000
PAPERLESS_API_TOKEN=

# Instancia externa de Paperless (paperless.yml). Paperless publica su interfaz
# en 8002 para dejar el 8000 a Kong. Los datos siguen en el directorio raíz del
# proyecto.
PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:latest
PAPERLESS_HOST_PORT=8002
PAPERLESS_DATA_ROOT=..
PAPERLESS_SECRET_KEY=

# Reintentos acotados de la notificación OCR -> ACL.
OCR_SYNC_MAX_ATTEMPTS=3
OCR_SYNC_INITIAL_BACKOFF_SECONDS=1
